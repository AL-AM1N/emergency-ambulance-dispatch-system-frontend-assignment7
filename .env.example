# Base URL of the Emergency Ambulance Dispatch System backend (include /api/v1).
# Live deployment:
NEXT_PUBLIC_API_BASE_URL=https://backend.url
# Local development (run the backend on port 5000):
# NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Google OAuth client id (must match the backend GOOGLE_CLIENT_ID audience).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=google_client_id

# Stripe publishable key (test mode). The secret key must stay on the backend only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_publicshable_key
